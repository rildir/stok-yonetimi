# Veritabanı Bağlantı Bilgileri (MySQL 8; docker-compose.yml maps the container to host port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=change_me_root_password
DB_DATABASE=stok_yonetimi
# Only read by docker-compose.yml (MySQL container + backend container credentials)
DB_ROOT_PASSWORD=change_me_root_password
DB_APP_USERNAME=stok_user
DB_APP_PASSWORD=change_me_app_password

# Ports / CORS (dev: backend 3001, frontend `npx nx serve frontend --port 4300`, proxy -> 3001)
PORT=3001
CORS_ORIGIN=http://localhost:4300,http://localhost:4200

# Güvenlik & JWT - at least 32 random characters (openssl rand -base64 48). Required in production.
JWT_SECRET=change_me_to_a_long_random_secret
# Initial super admin (created on the first start of an empty database). The password must meet the
# policy (min. 10 characters, 3 of: upper case, lower case, digit, symbol); otherwise a one-time password is
# written to INITIAL_ADMIN_PASSWORD_FILE (default ./initial-admin-password.txt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_Admin#2026
# Non-production demo accounts (manager / viewer / demo): one shared password that meets the policy,
# or leave empty to get random per-account passwords in DEMO_ACCOUNT_PASSWORDS_FILE
# (default ./demo-account-passwords.txt). Never seeded when NODE_ENV=production.
# DEMO_ACCOUNT_PASSWORD=
# DEMO_ACCOUNT_PASSWORDS_FILE=demo-account-passwords.txt

# WP5: integrator credentials are encrypted at rest (AES-256-GCM) with this key.
# 32 bytes as base64 or 64 hex characters (openssl rand -base64 32). Required in production
# (development falls back to an insecure built-in key with a warning). Rotation:
# EBELGE_CREDENTIALS_KEY_ID names the active key, older keys stay as EBELGE_CREDENTIALS_KEY_<ID>.
EBELGE_CREDENTIALS_KEY=
# EBELGE_CREDENTIALS_KEY_ID=k1

# Dev only: schema sync is guarded (it runs after `npx nx run backend:migration:run`) (refuses pending migrations / DROP COLUMN); set to false to disable it entirely
# DB_SYNCHRONIZE=false

# WP3: TCMB indicative rates (scheduler 15:45 Europe/Istanbul on business days)
# TCMB_FETCH_DISABLED=true
# TCMB_BASE_URL=https://www.tcmb.gov.tr/kurlar

# WP5: the mock e-Belge integrator never reaches GİB. It is refused for environment LIVE and, on a
# production server (NODE_ENV=production), unless this is set explicitly (demo installations only).
# EBELGE_ALLOW_MOCK=true

# WP7 - KVKK: field encryption of identity numbers (AES-256-GCM) and the search index (HMAC-SHA256).
# 32-byte keys, base64 or 64 hex characters (openssl rand -base64 32). Mandatory in production;
# never change them after data was written (the migration encrypts existing values with them).
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
# Sessions: access token 15-60 min (default 30), httpOnly refresh cookie, idle timeout
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_HOURS=12
# SESSION_IDLE_MINUTES=30
# COOKIE_SECURE=true
# TLS to MySQL (production default: on; DB_SSL=false only for a database on a private network)
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/mysql-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true
# Breach alarms (operational thresholds)
# KVKK_ALERT_LOGIN_FAILED=10
# KVKK_ALERT_EXPORT_ROWS=500
# KVKK_ALERT_API_READS=200
# Platform operator shown in the platform privacy notice
# (data controller identity, Aydınlatma Tebliği md. 4 - warned at start-up in production when missing)
# PLATFORM_OPERATOR_NAME=
# PLATFORM_OPERATOR_ADDRESS=
# PLATFORM_OPERATOR_MERSIS=
# PLATFORM_KVKK_EMAIL=
